# آدرس سرور TrendPilot (همون جایی که server/ روش دیپلوی شده — Vercel یا هرجای دیگه)
SERVER_BASE_URL=https://mt5-trend-bot.vercel.app

# باید دقیقاً با LOCAL_API_SECRET سمت سرور یکی باشه
API_SECRET=یک-رشته-تصادفی-طولانی-اینجا-بذار

# هر چند ثانیه یک‌بار push وضعیت / pull دستور انجام بشه
SYNC_INTERVAL_SEC=5

# مسیر فایل پروفایل‌ها (کنار همین اسکریپت ساخته می‌شه اگه نبود)
PROFILES_FILE=profiles.json
